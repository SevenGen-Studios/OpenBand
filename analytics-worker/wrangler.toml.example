name = "openband-analytics"
main = "src/index.ts"
compatibility_date = "2026-08-01"
workers_dev = false

[[d1_databases]]
binding = "DB"
database_name = "openband-analytics"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
ALLOWED_ORIGINS = "https://openband.ca,https://www.openband.ca"
DATA_RETENTION_DAYS = "760"
INTELLIGENCE_DATA_URL = "https://openband.ca/data.json"
CREATOR_SUPPORT_ENABLED = "false"
FINANCIAL_ENTRY_ENABLED = "false"

[triggers]
crons = ["17 4 * * *"]

# Add these with `wrangler secret put` rather than committing them:
# VISITOR_HASH_SALT
# ANALYTICS_ADMIN_TOKEN

# Required to accept donations. Use an unused namespace ID in this account.
[[ratelimits]]
name = "CREATOR_SUPPORT_RATE_LIMIT"
namespace_id = "1001"
  [ratelimits.simple]
  limit = 10
  period = 60

# Set CREATOR_SUPPORT_ENABLED = "true" in [vars] only after completing setup.
# Set STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET with wrangler secret put.

# Financial entry: set FINANCIAL_ADMINS and FINANCIAL_GITHUB_TOKEN using
# wrangler secret put. See docs/financial-entry.md before enabling.
